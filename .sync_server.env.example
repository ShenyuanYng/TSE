# Copy to .sync_server.env on your Mac, then edit. This file uses Bash syntax.
# Prefer an alias configured in ~/.ssh/config for ports, keys, and jump hosts.
SERVER_HOST='your-server-alias'
SERVER_REPO='/absolute/path/to/new_example_code'
SYNC_REMOTE='origin'

# Optional: use separate existing clones for the two branches.
# If omitted, both branches use SERVER_REPO and sync switches its branch.
# SERVER_REPO_MAIN='/absolute/path/to/new_example_code-main'
# SERVER_REPO_MIX='/absolute/path/to/new_example_code-mix'
